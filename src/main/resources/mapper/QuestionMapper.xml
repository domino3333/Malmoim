<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.malmoim.mapper.QuestionMapper">

    <insert id="insertQuestion" useGeneratedKeys="true" keyProperty="no" keyColumn="no">
        insert into question(participant_no,content,room_no,vote_count,status,created_at)
        values(#{participantNo},#{content},#{roomNo},#{voteCount},#{status},#{createdAt})
    </insert>

    <select id="getQuestionList" resultType="com.malmoim.dto.qna.question.QuestionResponse">
        SELECT
            Q.no AS questionNo,
            Q.participant_no,
            P.nickname,
            Q.content,
            Q.room_no,
            Q.vote_count,
            Q.created_at,
            Q.status
        FROM question Q
                 JOIN participant P
                      ON Q.participant_no = P.no
        WHERE Q.room_no = #{roomNo}
        ORDER BY Q.created_at ASC
    </select>

    <update id="plusOneVoteCount">
        update question set vote_count=vote_count+1 where no = #{questionNo}
    </update>
</mapper>
