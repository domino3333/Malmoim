<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.malmoim.mapper.QuestionMapper">

    <insert id="registerQuestion" useGeneratedKeys="true" keyProperty="no" keyColumn="no">
        insert into question(participant_no,content,room_no,vote_count,status)
        values(#{participantNo},#{question},#{roomNo},0,"WAITING")
    </insert>
</mapper>
